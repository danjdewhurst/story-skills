  "required_regex": [
    "(?:^|\\n)(?=[^\\n]*\\bstory add clue\\b)(?=[^\\n]*\\bkey\\b)(?=[^\\n]*--planted[ =]['\"]?chapter-01\\b)(?=[^\\n]*--payoff[ =]['\"]?chapter-12\\b)(?=[^\\n]*--characters?[ =]['\"]?(?:[a-z0-9-]+,[ \\t]*)*tomas-reyes\\b)(?![^\\n]*--significance-delayed)(?![^\\n]*--red-herring)",
    "(?:^|\\n)(?=[^\\n]*\\bstory add clue\\b)(?=[^\\n]*\\b(?:hour|noon|dusk)\\b)(?=[^\\n]*--planted[ =]['\"]?chapter-01\\b)(?=[^\\n]*--payoff[ =]['\"]?chapter-12\\b)(?=[^\\n]*--characters?[ =]['\"]?(?:[a-z0-9-]+,[ \\t]*)*tomas-reyes\\b)(?=[^\\n]*--significance-delayed)(?![^\\n]*--red-herring)",
    "(?:^|\\n)(?=[^\\n]*\\bstory add clue\\b)(?=[^\\n]*\\b(?:petra|thursday|boat)\\b)(?=[^\\n]*--planted[ =]['\"]?chapter-02\\b)(?=[^\\n]*--payoff[ =]['\"]?chapter-07\\b)(?=[^\\n]*--characters?[ =]['\"]?(?:[a-z0-9-]+,[ \\t]*)*petra-lindqvist\\b)(?=[^\\n]*--red-herring)",
    "story clues\\b"
  ],
  "banned": [
    "it was Ana",
    "it was Ana who",
    "Ana left it",
    "Petra left",
    "Petra had left",
    "Petra left it",
    "mystery solved",
    "the mystery was solved",
    "case closed",
    "the answer is",
    "here is the answer",
    "smuggler",
