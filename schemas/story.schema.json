{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danjdewhurst/story-skills/schemas/story.schema.json",
  "title": "Story Skills Schema v2",
  "$comment": "Entity ids are filename-derived: the kebab-case basename of the entity file without .md (e.g. characters/sera-voss.md -> sera-voss). Frontmatter never carries a separate id field; the required id in each definition below is that filename-derived identifier as it appears in reference lists and registries.",
  "type": "object",
  "required": ["story", "characters", "worldbuilding", "plot", "chapters", "scenes", "continuity", "glossary"],
  "properties": {
    "story": {
      "type": "object",
      "required": ["title", "schema-version", "genre", "status", "themes", "pov", "tense"],
      "properties": {
        "title": { "type": "string", "pattern": "\\S" },
        "schema-version": { "const": 2 },
        "series": { "$ref": "#/$defs/id" },
        "series-title": { "type": "string" },
        "book-number": { "type": "number", "minimum": 0 },
        "follows": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "precedes": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "genre": { "type": "string", "pattern": "\\S" },
        "sub-genre": { "type": "string" },
        "setting-era": { "type": "string" },
        "status": { "enum": ["planning", "drafting", "in-progress", "revising", "complete", "abandoned"] },
        "themes": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "pov": { "type": "string", "pattern": "\\S" },
        "tense": { "enum": ["past", "present", "future", "mixed"] },
        "premise": { "type": "string" },
        "counter-premise": { "type": "string" },
        "author": { "type": "string" },
        "contact": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
        "season-goal": { "type": "string" },
        "target-words": { "type": "integer", "minimum": 1 },
        "target-characters": { "type": "integer", "minimum": 1, "description": "Target length in characters, measured when the book counts characters (count-unit)." },
        "count-unit": { "enum": ["words", "characters"], "description": "The unit lengths are counted in. Defaults from the language: characters for Chinese (zh) and Japanese (ja), words otherwise." },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$" },
        "isbn": { "type": ["string", "integer"] },
        "publisher": { "type": "string" },
        "publication-date": { "type": "string", "pattern": "^(?:\\d{4}-\\d{2}-\\d{2})?$", "description": "YYYY-MM-DD; empty means not set yet." },
        "description": { "type": "string" },
        "keywords": { "$ref": "#/$defs/stringList" },
        "subjects": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{3}\\d{6}$" } },
        "copyright": { "type": "string" },
        "ifid": { "type": "string", "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$", "description": "Interactive fiction id (a version 4 UUID) for build --format twee; without it the build derives a stable one from the story id." },
        "cover-alt": { "type": "string" },
        "ai-disclosure": { "type": "string" },
        "chapter-label": { "type": "string", "description": "Word for generated chapter headings, such as Kapitel; {n} places the number. Defaults to the language pack's word (Chapter in English). Same as a labels chapter entry, which wins." },
        "writing-mode": { "enum": ["horizontal", "vertical"], "description": "How builds set the text. vertical sets columns top to bottom, right to left, with pages turned right to left; story validate allows it only for a language written that way, such as ja, zh, zh-Hant, or ko. Defaults to horizontal." },
        "chapter-numerals": { "enum": ["western", "native"], "description": "Numerals for the numbers in generated chapter headings. native prints the language's own: Han numerals in Japanese and Chinese (第十二章), the script's digits in Arabic, Persian, Hindi, Thai, and others; story validate allows it only for a language that has them. Ids, file names, and anchors keep 0-9. Defaults to western." },
        "contents-label": { "type": "string", "description": "Heading for generated tables of contents, such as Inhalt. Defaults to the language pack's heading (Contents in English). Same as a labels contents entry, which wins." },
        "labels": {
          "type": "array",
          "description": "Overrides for the generated text in builds, as - key: text entries; {name} places a value. The language pack (from language) supplies the defaults, English where it has none. labels wins over chapter-label and contents-label. story validate warns about a key that is not listed here.",
          "items": {
            "type": "object",
            "properties": { "chapter": { "type": "string" }, "chapter-heading": { "type": "string" }, "contents": { "type": "string" }, "and": { "type": "string" }, "copyright": { "type": "string" }, "all-rights-reserved": { "type": "string" }, "published-by": { "type": "string" }, "scene-break": { "type": "string" }, "cover-alt": { "type": "string" }, "start-of-content": { "type": "string" }, "accessibility-summary": { "type": "string" }, "accessibility-summary-cover": { "type": "string" }, "review-title": { "type": "string" }, "review-intro": { "type": "string" }, "review-intro-build": { "type": "string" }, "review-labels": { "type": "string" }, "review-quote": { "type": "string" }, "review-quote-build": { "type": "string" }, "review-note-link": { "type": "string" }, "note": { "type": "string" }, "note-title": { "type": "string" }, "anchor-title": { "type": "string" }, "by": { "type": "string" }, "approximate-words": { "type": "string" }, "approximate-characters": { "type": "string" }, "narration-opening": { "type": "string" }, "narration-opening-anonymous": { "type": "string" }, "narration-closing": { "type": "string" }, "narration-closing-anonymous": { "type": "string" }, "screenplay-credit": { "type": "string" }, "screenplay-source": { "type": "string" }, "screenplay-source-anonymous": { "type": "string" } }
          }
        },
        "authors": { "$ref": "#/$defs/stringList" },
        "form": { "enum": ["flash", "short-story", "novelette", "novella", "novel", "serial", "picture-book", "chapter-book"] },
        "draft-mode": { "enum": ["discovered", "outlined"] },
        "cover": { "type": "string", "minLength": 1, "pattern": "[^/\\\\]\\.(?:[Gg][Ii][Ff]|[Jj][Pp][Ee]?[Gg]|[Pp][Nn][Gg]|[Ww][Ee][Bb][Pp])\\s*$", "description": "Cover image path relative to story.md: a .gif, .jpeg, .jpg, .png, or .webp file. story validate also checks the file exists." },
        "deadline": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "revision-passes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pass"],
            "properties": {
              "pass": { "$ref": "#/$defs/id" },
              "status": { "enum": ["pending", "in-progress", "done"] }
            }
          }
        },
        "cli-defaults": {
          "type": "array",
          "description": "Default flags per story command. Each entry names a command that takes a project; its other keys are flags that command accepts, without the leading --. A flag given on the command line always wins. story validate rejects unknown commands and flags.",
          "items": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "pattern": "^[a-z]+$" }
            }
          }
        },
        "severity": {
          "type": "array",
          "description": "Promote a named warning to an error, or turn it off (it is then reported as dismissed).",
          "items": {
            "type": "object",
            "required": ["warning", "level"],
            "properties": {
              "warning": { "enum": ["windows-reserved-name", "stray-file", "nested-file", "symlinked-file", "interrupted-write", "stale-registry", "stale-word-count", "todo-markers", "unclosed-comment", "no-scene-records", "empty-chapter", "near-miss-key", "duplicate-route", "deceased-without-died-in", "style-sample-missing", "style-sample-own-chapters", "unknown-word-list", "research-no-sources", "research-unsettled", "research-unreviewed", "empty-matter", "permission-pending", "permission-no-rights-holder", "backslash-path", "form-length-range", "unused-target", "session-without-characters", "too-many-keywords", "todo-placeholder", "author-and-authors", "unknown-label", "blank-label", "legacy-backlink-type", "unreachable-chapter", "deceased-in-cast", "progression-deceased-in-cast", "progression-death-conflict", "pov-not-in-cast", "pov-scene-mismatch", "scene-cast-not-in-chapter", "scene-location-not-in-chapter", "cut-character-in-cast", "cut-character-in-arc", "cut-character-relationship", "chapter-numbering-start", "chapter-numbering-gap", "promise-stale-planned", "promise-payoff-passed", "promise-unpaid", "clue-stale-planned", "clue-payoff-passed", "clue-unpaid", "current-chapter-behind", "state-duplicate-character", "state-duplicate-artifact", "state-status-conflict", "deceased-learning", "progression-deceased-learning", "learner-not-in-cast", "knowledge-not-recorded", "state-tracks-dead-character", "state-location-drift", "object-not-recorded", "state-object-drift", "malformed-date", "malformed-time", "negative-travel-hours", "travel-hours-undated", "clock-backward", "series-id-missing", "series-title-mismatch", "canon-name-mismatch", "canon-pronunciation-mismatch", "canon-destroyed-status", "prose-filter-words", "prose-adverbs", "prose-bookisms", "prose-avoided-spelling", "prose-uniform-sentences", "prose-similar-names", "prose-baseline-sentences", "prose-baseline-paragraphs", "prose-baseline-dialogue", "prose-baseline-filter-words", "prose-baseline-adverbs", "prose-baseline-small", "style-sample-unreadable", "pacing-no-hook", "pacing-no-sequel", "pacing-easy-wins", "pacing-resolution-run", "pacing-long-chapter", "pacing-short-chapter", "clue-unplanted", "clue-late-plant", "clue-no-characters", "clue-herring-unresolved", "clue-none-delayed", "voice-avoid", "voice-words-unused", "voice-sound-alike", "name-look-alike", "name-shared-initial", "context-file-skipped", "story-missing-at-ref", "similarity-shared-passage", "similarity-no-reference-text", "derived-ifid", "scene-outside-book", "scene-no-location", "scene-unknown-location", "chapter-no-scenes", "scene-no-setting", "unknown-reference", "adopted-references", "linked-book-id", "choices-dropped", "leftover-references", "stale-exemption"] },
              "level": { "enum": ["error", "warning", "off"] }
            }
          }
        }
      }
    },
    "characters": { "type": "array", "items": { "$ref": "#/$defs/character" } },
    "worldbuilding": {
      "type": "object",
      "properties": {
        "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/system" } },
        "factions": { "type": "array", "items": { "$ref": "#/$defs/faction" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "plot": {
      "type": "object",
      "properties": {
        "arcs": { "type": "array", "items": { "$ref": "#/$defs/arc" } }
      }
    },
    "chapters": { "type": "array", "items": { "$ref": "#/$defs/chapter" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "continuity": {
      "type": "object",
      "properties": {
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "promises": { "type": "array", "items": { "$ref": "#/$defs/promise" } },
        "clues": { "type": "array", "items": { "$ref": "#/$defs/clue" } },
        "current-chapter": { "type": "integer", "minimum": 0 },
        "character-state": { "type": "array", "items": { "$ref": "#/$defs/characterState" } },
        "object-state": { "type": "array", "items": { "$ref": "#/$defs/objectState" } },
        "knowledge-state": { "type": "array", "items": { "$ref": "#/$defs/knowledgeState" } },
        "exemptions": { "type": "array", "items": { "$ref": "#/$defs/exemption" } }
      }
    },
    "glossary": { "type": "array", "items": { "$ref": "#/$defs/term" } },
    "styleSheet": { "$ref": "#/$defs/styleSheet" },
    "matter": { "type": "array", "items": { "$ref": "#/$defs/matter" } },
    "research": { "type": "array", "items": { "$ref": "#/$defs/research" } },
    "progressLog": { "$ref": "#/$defs/progressLog" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Filename-derived identifier: the kebab-case basename of the entity file without .md. There is no separate id frontmatter field."
    },
    "stringList": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
    "character": {
      "type": "object",
      "required": ["id", "name", "role", "status"],
      "properties": {
        "pronunciation": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "\\S" },
        "role": { "enum": ["protagonist", "antagonist", "supporting", "minor", "narrator", "deuteragonist"] },
        "status": { "enum": ["alive", "deceased", "unknown", "missing", "cut"] },
        "died-in": { "type": "string" },
        "revived-in": { "type": "string" },
        "aliases": { "$ref": "#/$defs/stringList" },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["character", "type"],
            "properties": {
              "character": { "$ref": "#/$defs/id" },
              "type": { "type": "string", "pattern": "\\S" }
            }
          }
        },
        "locations": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "arc": { "type": "string" },
        "arc-type": { "enum": ["change-positive", "change-negative", "flat"] },
        "lie": { "type": "string" },
        "truth": { "type": "string" },
        "ghost-wound": { "type": "string" },
        "voice-words": { "$ref": "#/$defs/stringList" },
        "voice-avoid": { "$ref": "#/$defs/stringList" },
        "progressions": { "$ref": "#/$defs/progressions" }
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "pronunciation": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "\\S" },
        "type": { "type": "string", "pattern": "\\S" },
        "region": { "type": "string" },
        "population": { "type": ["string", "integer"] },
        "controlled-by": { "type": "string" },
        "notable-characters": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "status": { "type": "string" },
        "setting": { "enum": ["interior", "exterior", "both"] },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["to", "hours"],
            "properties": {
              "to": { "$ref": "#/$defs/id" },
              "hours": { "type": "number", "exclusiveMinimum": 0 },
              "mode": { "type": "string" }
            }
          }
        },
        "progressions": { "$ref": "#/$defs/progressions" }
      }
    },
    "system": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "\\S" },
        "type": { "type": "string", "pattern": "\\S" },
        "prevalence": { "type": "string" },
        "pronunciation": { "type": "string" }
      }
    },
    "faction": {
      "type": "object",
      "required": ["id", "name", "type", "status"],
      "properties": {
        "pronunciation": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "\\S" },
        "type": { "enum": ["family", "guild", "government", "military", "religion", "company", "community", "criminal", "other"] },
        "status": { "enum": ["active", "hidden", "declining", "defeated", "disbanded", "unknown"] },
        "members": { "$ref": "#/$defs/stringList" },
        "locations": { "$ref": "#/$defs/stringList" },
        "tags": { "$ref": "#/$defs/stringList" },
        "progressions": { "$ref": "#/$defs/progressions" }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "name", "type", "status"],
      "properties": {
        "pronunciation": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "\\S" },
        "type": { "enum": ["object", "weapon", "document", "technology", "relic", "symbol", "resource", "other"] },
        "status": { "enum": ["active", "lost", "destroyed", "hidden", "transferred", "unknown"] },
        "owner": { "type": "string" },
        "location": { "type": "string" },
        "tags": { "$ref": "#/$defs/stringList" }
      }
    },
    "arc": {
      "type": "object",
      "required": ["id", "name", "type", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "\\S" },
        "type": { "enum": ["main", "subplot", "character", "thematic"] },
        "status": { "enum": ["planned", "in-progress", "resolved"] },
        "characters": { "$ref": "#/$defs/stringList" },
        "themes": { "$ref": "#/$defs/stringList" },
        "acts": { "$ref": "#/$defs/stringList" },
        "mice-threads": { "$ref": "#/$defs/stringList" }
      }
    },
    "chapter": {
      "type": "object",
      "required": ["id", "title", "number", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "number": { "type": "integer", "minimum": 1 },
        "numbered": { "type": "boolean", "description": "false builds the chapter under its title alone (a Prologue or Epilogue) and leaves it out of the printed chapter count." },
        "status": { "enum": ["outline", "draft", "revised", "final", "complete"] },
        "pov": { "type": "string" },
        "word-count": { "type": "integer", "minimum": 0 },
        "target-words": { "type": "integer", "minimum": 1 },
        "character-count": { "type": "integer", "minimum": 0, "description": "Characters of prose, which story wordcount --write records when the book counts characters." },
        "target-characters": { "type": "integer", "minimum": 1 },
        "arcs-advanced": { "$ref": "#/$defs/stringList" },
        "characters": { "$ref": "#/$defs/stringList" },
        "mentions": { "$ref": "#/$defs/stringList" },
        "locations": { "$ref": "#/$defs/stringList" },
        "mode": { "enum": ["discovered", "outlined", ""], "description": "How the chapter was written. story add chapter writes an empty mode, which means unset." },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "strand": { "type": "string" },
        "episode-question": { "type": "string" },
        "hook": { "enum": ["cliffhanger", "question", "revelation", "reversal", "decision", "emotional", "resolution"] },
        "time-skip": { "type": "string" },
        "choices": {
          "type": "array",
          "description": "Branching: the choices that end this chapter, each leading to another chapter. Once any chapter has choices, a chapter without them is an ending. build --format twee turns them into Twine links.",
          "items": {
            "type": "object",
            "required": ["text", "to"],
            "properties": {
              "text": { "type": "string", "pattern": "^(?=.*\\S)(?!.*(?:->|<-))(?!.*<\\s*$)[^\\[\\]|\\r\\n]+$", "description": "The words the reader picks; no [, ], |, ->, <-, or line break, and no final <, which Twine reads as link syntax." },
              "to": { "$ref": "#/$defs/id" }
            }
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "title", "chapter", "scene", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "chapter": { "$ref": "#/$defs/id" },
        "scene": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["outline", "draft", "revised", "final", "complete"] },
        "pov": { "type": "string" },
        "location": { "type": "string" },
        "characters": { "$ref": "#/$defs/stringList" },
        "mentions": { "$ref": "#/$defs/stringList" },
        "arcs-advanced": { "$ref": "#/$defs/stringList" },
        "state-changes": {
          "type": "array",
          "items": { "type": "object" }
        },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "travel-hours": { "type": "number" },
        "sequel": { "type": "boolean" },
        "outcome": { "enum": ["yes", "no", "yes-but", "no-and"] },
        "dilemma": { "type": "string" },
        "flashback-to": { "type": "string" },
        "setting": { "enum": ["interior", "exterior", "both"] }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "status": { "enum": ["open", "answered", "resolved", "dropped", "abandoned"] },
        "introduced": { "type": "string" },
        "resolved": { "type": "string" },
        "characters": { "$ref": "#/$defs/stringList" }
      }
    },
    "promise": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "status": { "enum": ["planned", "planted", "paid-off", "dropped", "abandoned"] },
        "planted": { "type": "string" },
        "payoff": { "type": "string" },
        "arcs": { "$ref": "#/$defs/stringList" },
        "characters": { "$ref": "#/$defs/stringList" }
      }
    },
    "clue": {
      "type": "object",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "status": { "enum": ["planned", "planted", "paid-off", "dropped", "abandoned"] },
        "planted": { "type": "string" },
        "payoff": { "type": "string" },
        "significance-delayed": { "type": "boolean" },
        "red-herring": { "type": "boolean" },
        "arcs": { "$ref": "#/$defs/stringList" },
        "characters": { "$ref": "#/$defs/stringList" }
      }
    },
    "term": {
      "type": "object",
      "required": ["id", "term", "category"],
      "properties": {
        "pronunciation": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "term": { "type": "string", "pattern": "\\S" },
        "category": { "enum": ["person", "place", "faction", "artifact", "concept", "term", "other"] },
        "aliases": { "$ref": "#/$defs/stringList" }
      }
    },
    "progressions": {
      "type": "array",
      "description": "Timeline-scoped changes to a character, location, or faction. The frontmatter describes the entity as the story opens; from the chapter in from onward (in story time), field holds value instead. Entries are listed in story order, and field names a single-value field, never a list field, id, progressions, died-in, or revived-in.",
      "items": {
        "type": "object",
        "required": ["from", "field", "value"],
        "properties": {
          "from": { "$ref": "#/$defs/id" },
          "field": { "$ref": "#/$defs/id" },
          "value": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "characterState": {
      "type": "object",
      "properties": {
        "character": { "$ref": "#/$defs/id" },
        "location": { "type": "string" },
        "physical": { "type": "string" },
        "emotional": { "type": "string" },
        "knowledge": { "type": "string" }
      }
    },
    "objectState": {
      "type": "object",
      "properties": {
        "artifact": { "$ref": "#/$defs/id" },
        "owner": { "type": "string" },
        "location": { "type": "string" },
        "status": { "enum": ["active", "lost", "destroyed", "hidden", "transferred", "unknown"] },
        "since": { "type": "string" }
      }
    },
    "knowledgeState": {
      "type": "object",
      "properties": {
        "character": { "$ref": "#/$defs/id" },
        "knows": { "type": "string" },
        "fact": { "$ref": "#/$defs/id" },
        "learned-in": { "type": "string" }
      }
    },
    "progressLog": {
      "type": "object",
      "description": "Optional progress.md frontmatter: one manuscript word count per logged day, written by story progress --log.",
      "required": ["type"],
      "properties": {
        "type": { "const": "progress-log" },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "words"],
            "properties": {
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "words": { "type": "integer", "minimum": 0 },
              "characters": { "type": "integer", "minimum": 0, "description": "The manuscript in characters, logged when the book counts characters." }
            }
          }
        }
      }
    },
    "research": {
      "type": "object",
      "description": "Research note in research/: a fact the story relies on, its sources, and the chapters that use it.",
      "required": ["id", "title", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "status": { "enum": ["open", "verified", "disputed"] },
        "sources": { "$ref": "#/$defs/stringList" },
        "used-in": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "accuracy": { "enum": ["must-be-accurate", "blended", "invented"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "method": { "enum": ["fact", "interview", "site-visit", "expert-review", "reading"] },
        "risk": { "type": "array", "items": { "enum": ["legal", "medical", "weapons", "safety", "cultural", "defamation", "technical"] } },
        "reviewed-by": { "$ref": "#/$defs/stringList" }
      }
    },
    "matter": {
      "type": "object",
      "description": "Front or back matter in matter/: dedication, epigraph, acknowledgments, author's note, about the author.",
      "required": ["id", "title", "placement"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "pattern": "\\S" },
        "placement": { "enum": ["front", "back"] },
        "order": { "type": "integer", "minimum": 0 },
        "heading": { "type": "boolean" },
        "permission": { "enum": ["not-needed", "pending", "granted", "public-domain"] },
        "rights-holder": { "type": "string" },
        "credit": { "type": "string" }
      }
    },
    "styleWordLists": {
      "type": "array",
      "$comment": "Each value is words separated by commas, a flow list such as [sintió, vio], or [] for none. story validate warns about a list name it does not know (unknown-word-list).",
      "items": {
        "type": "object",
        "properties": { "filter-words": { "type": ["string", "array"], "items": { "type": "string" } }, "said-bookisms": { "type": ["string", "array"], "items": { "type": "string" } }, "plain-tags": { "type": ["string", "array"], "items": { "type": "string" } }, "beat-pronouns": { "type": ["string", "array"], "items": { "type": "string" } }, "inversion-links": { "type": ["string", "array"], "items": { "type": "string" } }, "adverb-suffixes": { "type": ["string", "array"], "items": { "type": "string" } }, "adverb-exceptions": { "type": ["string", "array"], "items": { "type": "string" } }, "adverb-blockers": { "type": ["string", "array"], "items": { "type": "string" } }, "echo-stopwords": { "type": ["string", "array"], "items": { "type": "string" } }, "phrase-stopwords": { "type": ["string", "array"], "items": { "type": "string" } }, "dialect-pairs": { "type": ["string", "array"], "items": { "type": "string" } }, "speech-verbs": { "type": ["string", "array"], "items": { "type": "string" } }, "speech-pronouns": { "type": ["string", "array"], "items": { "type": "string" } }, "contraction-suffixes": { "type": ["string", "array"], "items": { "type": "string" } }, "contracted-is": { "type": ["string", "array"], "items": { "type": "string" } }, "elisions": { "type": ["string", "array"], "items": { "type": "string" } }, "voice-stopwords": { "type": ["string", "array"], "items": { "type": "string" } }, "title-abbreviations": { "type": ["string", "array"], "items": { "type": "string" } }, "context-abbreviations": { "type": ["string", "array"], "items": { "type": "string" } }, "calendar-words": { "type": ["string", "array"], "items": { "type": "string" } }, "chapter-words": { "type": ["string", "array"], "items": { "type": "string" } }, "section-words": { "type": ["string", "array"], "items": { "type": "string" } }, "part-words": { "type": ["string", "array"], "items": { "type": "string" } }, "front-matter-words": { "type": ["string", "array"], "items": { "type": "string" } }, "ordinal-words": { "type": ["string", "array"], "items": { "type": "string" } }, "number-words": { "type": ["string", "array"], "items": { "type": "string" } }, "number-joiners": { "type": ["string", "array"], "items": { "type": "string" } }, "candidate-stopwords": { "type": ["string", "array"], "items": { "type": "string" } }, "determiners": { "type": ["string", "array"], "items": { "type": "string" } }, "relative-words": { "type": ["string", "array"], "items": { "type": "string" } }, "noun-suffixes": { "type": ["string", "array"], "items": { "type": "string" } }, "title-words": { "type": ["string", "array"], "items": { "type": "string" } } }
      }
    },
    "styleSheet": {
      "type": "object",
      "description": "Optional style-sheet.md frontmatter: house spelling and usage decisions enforced by story prose.",
      "required": ["type"],
      "properties": {
        "type": { "const": "style-sheet" },
        "dialect": { "enum": ["british", "american", "unspecified"] },
        "preferred": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["use", "avoid"],
            "properties": {
              "use": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "avoid": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        },
        "watch-words": { "$ref": "#/$defs/stringList" },
        "allow-words": { "$ref": "#/$defs/stringList" },
        "replace-words": { "$ref": "#/$defs/styleWordLists", "description": "Replaces language-pack word lists, as - list-name: word, word entries ([] empties a list), such as - filter-words: sintió, vio." },
        "add-words": { "$ref": "#/$defs/styleWordLists", "description": "Adds words to language-pack word lists, as - list-name: word, word entries, such as - said-bookisms: rugió." },
        "samples": {
          "type": "array",
          "description": "Files or folders of the author's own prose, relative to the project folder (such as ../book-one), that story prose builds a baseline from.",
          "items": { "type": "string", "pattern": "^(?![/\\\\])(?![A-Za-z]:)\\s*\\S" }
        }
      }
    },
    "exemption": {
      "type": "object",
      "$comment": "An entry matches a finding when every key it sets matches. story validate also requires a pattern, or a code with a file, chapter, or pattern; refuses a chapter with a code whose findings carry none, and a misspelled key; entries it rejects never take effect.",
      "required": ["reason"],
      "properties": {
        "pattern": { "type": "string", "minLength": 4, "pattern": "\\S", "description": "Text the finding's message contains, as a case-sensitive substring; / and \\ in paths match either separator." },
        "code": { "enum": ["windows-reserved-name", "stray-file", "nested-file", "symlinked-file", "interrupted-write", "stale-registry", "stale-word-count", "todo-markers", "unclosed-comment", "no-scene-records", "empty-chapter", "near-miss-key", "duplicate-route", "deceased-without-died-in", "style-sample-missing", "style-sample-own-chapters", "unknown-word-list", "research-no-sources", "research-unsettled", "research-unreviewed", "empty-matter", "permission-pending", "permission-no-rights-holder", "backslash-path", "form-length-range", "unused-target", "session-without-characters", "too-many-keywords", "todo-placeholder", "author-and-authors", "unknown-label", "blank-label", "legacy-backlink-type", "unreachable-chapter", "deceased-in-cast", "progression-deceased-in-cast", "progression-death-conflict", "pov-not-in-cast", "pov-scene-mismatch", "scene-cast-not-in-chapter", "scene-location-not-in-chapter", "cut-character-in-cast", "cut-character-in-arc", "cut-character-relationship", "chapter-numbering-start", "chapter-numbering-gap", "promise-stale-planned", "promise-payoff-passed", "promise-unpaid", "clue-stale-planned", "clue-payoff-passed", "clue-unpaid", "current-chapter-behind", "state-duplicate-character", "state-duplicate-artifact", "state-status-conflict", "deceased-learning", "progression-deceased-learning", "learner-not-in-cast", "knowledge-not-recorded", "state-tracks-dead-character", "state-location-drift", "object-not-recorded", "state-object-drift", "malformed-date", "malformed-time", "negative-travel-hours", "travel-hours-undated", "clock-backward", "series-id-missing", "series-title-mismatch", "canon-name-mismatch", "canon-pronunciation-mismatch", "canon-destroyed-status", "prose-filter-words", "prose-adverbs", "prose-bookisms", "prose-avoided-spelling", "prose-uniform-sentences", "prose-similar-names", "prose-baseline-sentences", "prose-baseline-paragraphs", "prose-baseline-dialogue", "prose-baseline-filter-words", "prose-baseline-adverbs", "prose-baseline-small", "style-sample-unreadable", "pacing-no-hook", "pacing-no-sequel", "pacing-easy-wins", "pacing-resolution-run", "pacing-long-chapter", "pacing-short-chapter", "clue-unplanted", "clue-late-plant", "clue-no-characters", "clue-herring-unresolved", "clue-none-delayed", "voice-avoid", "voice-words-unused", "voice-sound-alike", "name-look-alike", "name-shared-initial", "context-file-skipped", "story-missing-at-ref", "similarity-shared-passage", "similarity-no-reference-text", "derived-ifid", "scene-outside-book", "scene-no-location", "scene-unknown-location", "chapter-no-scenes", "scene-no-setting", "unknown-reference", "adopted-references", "linked-book-id", "choices-dropped", "leftover-references", "stale-exemption", "unreadable-file", "entry-not-mapping", "revived-without-death", "died-in-missing-chapter", "revived-in-missing-chapter", "revival-before-death", "death-status-mismatch", "revival-status-mismatch", "posthumous-appearance", "promise-payoff-before-plant", "promise-payoff-missing", "promise-plant-missing", "question-resolved-before-introduced", "question-resolution-missing", "question-open-but-resolved", "clue-payoff-before-plant", "clue-payoff-missing", "clue-plant-missing", "complete-with-open-promise", "complete-with-open-question", "complete-with-open-clue", "current-chapter-ahead", "state-missing-character", "state-missing-location", "state-missing-artifact", "state-missing-owner", "state-missing-chapter", "state-missing-knows", "state-fact-not-kebab", "state-duplicate-fact", "posthumous-learning", "gone-artifact-used", "gone-artifact-mentioned", "travel-too-fast", "route-same-time", "route-too-fast"], "description": "The finding's code: any warning a story.md severity entry can name, or an error story continuity reports." },
        "file": { "type": "string", "pattern": "^(?!.*\\x00)(?![/\\\\])(?![A-Za-z]:)(?!(?:.*[/\\\\])?\\.\\.(?:[/\\\\]|$))(?!\\.?[/\\\\]*$).*\\S", "description": "The project file the finding is about, relative to story.md, such as chapters/chapter-03.md: no absolute path and no .. segment." },
        "chapter": { "$ref": "#/$defs/id", "description": "The chapter a finding that carries a chapter shows up in, such as chapter-03." },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
