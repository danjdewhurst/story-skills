{
  "name": "series-continuity",
  "skill": "series-continuity",
  "brief": "Write book two's `## Series Notes` section for its story.md and the frontmatter of its opening continuity/state.md that carry this canon into book two. State each fact so a new draft cannot contradict it. Name no new characters, add no new history, resolve nothing.",
  "keep": "file",
  "required": [
    "Series Notes",
    "Ana",
    "Fresnel",
    "paraffin",
    "sea-chest"
  ],
  "required_regex": [
    "(?:^|\\n)[ \\t]*current-chapter: *0\\b",
    "fact: *['\"]?key-on-the-door\\b",
    "fact: *['\"]?board-wants-conversion\\b"
  ],
  "banned": [
    "is now electric",
    "was converted",
    "converted the lamp",
    "Petra died",
    "Petra is dead",
    "lost Petra",
    "a new keeper",
    "the new keeper",
    "his successor",
    "the logbook",
    "it was Ana",
    "it was Ana who",
    "mystery solved",
    "the mystery was solved",
    "case closed"
  ],
  "banned_regex": [
    "(?:^|\\n)[ \\t-]*learned-in:[ \\t]*[^\\s#]",
    "(?:^|\\n)[ \\t-]*since:[ \\t]*[^\\s#]",
    "(?<!\\b(?:not|never|nobody|no one)\\s+(?:\\w+\\s+){0,2}|n't\\s+(?:\\w+\\s+){0,2})\\bopened (?:the (?:sea[- ]?)?chest|it)\\b",
    "\\b(?:is|was|has been|had been|gets|got) (?:now )?answered\\b"
  ],
  "max_words": 400,
  "baseline_margin": 2
}
