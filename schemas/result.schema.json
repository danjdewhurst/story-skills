{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danjdewhurst/story-skills/schemas/result.schema.json",
  "title": "Story Skills CLI result, apiVersion story/v2",
  "$comment": "The object `story <command> --json` prints. The envelope is the same for every command; `data` depends on `command` and is described under $defs/data-<command>. A failure before the command produced a result (a usage error, a missing project) has data null. Fields may be added within story/v2; renaming, removing, or retyping one changes apiVersion. story/v2 made diagnostics[].code the finding's rule code (story/v1, in 0.16.0, had the check name there) and added diagnostics[].check.",
  "type": "object",
  "required": ["apiVersion", "command", "ok", "data", "diagnostics", "writes"],
  "properties": {
    "apiVersion": { "const": "story/v2" },
    "command": {
      "enum": ["validate", "links", "continuity", "series", "next", "doctor", "report", "knowledge", "context", "timeline", "prose", "voices", "pacing", "clues", "progress", "similarity"]
    },
    "ok": { "type": "boolean", "description": "True exactly when the command exits 0." },
    "data": { "type": ["object", "null"] },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "writes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Absolute paths of the files the command wrote." }
  },
  "allOf": [
    { "if": { "properties": { "command": { "enum": ["validate", "links", "continuity"] }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-check" } } } },
    { "if": { "properties": { "command": { "const": "series" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-series" } } } },
    { "if": { "properties": { "command": { "enum": ["next", "doctor"] }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-next" } } } },
    { "if": { "properties": { "command": { "const": "report" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-report" } } } },
    { "if": { "properties": { "command": { "const": "knowledge" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-knowledge" } } } },
    { "if": { "properties": { "command": { "const": "context" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-context" } } } },
    { "if": { "properties": { "command": { "const": "timeline" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-timeline" } } } },
    { "if": { "properties": { "command": { "const": "prose" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-prose" } } } },
    { "if": { "properties": { "command": { "const": "voices" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-voices" } } } },
    { "if": { "properties": { "command": { "const": "pacing" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-pacing" } } } },
    { "if": { "properties": { "command": { "const": "clues" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-clues" } } } },
    { "if": { "properties": { "command": { "const": "progress" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-progress" } } } },
    { "if": { "properties": { "command": { "const": "similarity" }, "data": { "type": "object" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/data-similarity" } } } },
    { "if": { "properties": { "data": { "type": "null" } } }, "then": { "properties": { "ok": { "const": false } } } }
  ],
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["severity", "file", "message", "code", "check"],
      "properties": {
        "severity": { "enum": ["error", "warning", "dismissed"] },
        "file": { "type": ["string", "null"], "description": "The project file the finding is about, relative to the project root (a linked book's file starts with its folder); stdin for a finding about a passage piped to prose - or voices -; or null when it is about no one file." },
        "chapter": { "type": ["string", "null"], "description": "The id of the chapter the finding shows up in, for the story continuity findings that carry one (docs/continuity.md lists them); null otherwise. An exemption's chapter key matches it." },
        "message": { "type": "string", "minLength": 1, "description": "The finding as the text output prints it, without the [code] the text output adds after a warning or a promoted warning." },
        "code": { "enum": ["unreadable-file", "missing-required-path", "windows-reserved-name", "stray-file", "nested-file", "symlinked-file", "interrupted-write", "stale-registry", "stale-word-count", "todo-markers", "unclosed-comment", "no-scene-records", "empty-chapter", "missing-field", "field-not-scalar", "field-not-list", "field-invalid-items", "field-not-integer", "field-not-number", "field-not-boolean", "field-not-text", "field-below-minimum", "unsupported-value", "id-not-kebab", "near-miss-key", "wrong-type", "story-id-mismatch", "entry-not-mapping", "schema-too-new", "schema-version-mismatch", "invalid-book-number", "invalid-ifid", "invalid-cover", "invalid-date", "invalid-cli-config", "invalid-filename", "filename-number-mismatch", "duplicate-chapter-number", "duplicate-scene-number", "unnumbered-without-title", "invalid-choice", "invalid-route-hours", "duplicate-route", "deceased-without-died-in", "progression-fixed-field", "progression-list-field", "progression-duplicate", "progression-out-of-order", "duplicate-pass", "exemption-pattern-too-short", "exemption-unknown-code", "exemption-code-not-dismissible", "exemption-file-not-relative", "exemption-too-broad", "exemption-misspelled-key", "exemption-chapter-not-carried", "style-use-equals-avoid", "duplicate-session-date", "research-no-sources", "research-unsettled", "research-unreviewed", "empty-matter", "permission-pending", "permission-no-rights-holder", "backslash-path", "form-length-range", "invalid-language", "invalid-isbn", "invalid-subject", "too-many-keywords", "todo-placeholder", "author-and-authors", "missing-reference", "missing-backlink", "backlink-type-mismatch", "legacy-backlink-type", "route-to-self", "broken-link", "link-backslash", "link-not-kebab", "link-outside-project", "unreachable-chapter", "series-link-backslash", "series-link-self", "series-link-unreadable", "series-link-not-project", "series-link-not-sibling", "series-missing-backlink", "series-link-other-series", "revived-without-death", "died-in-missing-chapter", "revived-in-missing-chapter", "revival-before-death", "death-status-mismatch", "revival-status-mismatch", "posthumous-appearance", "deceased-in-cast", "progression-deceased-in-cast", "progression-death-conflict", "pov-not-in-cast", "pov-scene-mismatch", "scene-cast-not-in-chapter", "scene-location-not-in-chapter", "cut-character-in-cast", "cut-character-in-arc", "cut-character-relationship", "chapter-numbering-start", "chapter-numbering-gap", "promise-payoff-before-plant", "promise-payoff-missing", "promise-plant-missing", "promise-stale-planned", "promise-payoff-passed", "promise-unpaid", "question-resolved-before-introduced", "question-resolution-missing", "question-open-but-resolved", "clue-payoff-before-plant", "clue-payoff-missing", "clue-plant-missing", "clue-stale-planned", "clue-payoff-passed", "clue-unpaid", "complete-with-open-promise", "complete-with-open-question", "complete-with-open-clue", "current-chapter-ahead", "current-chapter-behind", "state-missing-character", "state-missing-location", "state-missing-artifact", "state-missing-owner", "state-missing-chapter", "state-missing-knows", "state-fact-not-kebab", "state-duplicate-fact", "state-duplicate-character", "state-duplicate-artifact", "state-status-conflict", "posthumous-learning", "deceased-learning", "progression-deceased-learning", "learner-not-in-cast", "knowledge-not-recorded", "state-tracks-dead-character", "state-location-drift", "object-not-recorded", "state-object-drift", "gone-artifact-used", "gone-artifact-mentioned", "malformed-date", "malformed-time", "negative-travel-hours", "travel-hours-undated", "clock-backward", "travel-too-fast", "route-same-time", "route-too-fast", "series-link-outside", "series-too-many-books", "series-conflict", "series-id-missing", "series-title-mismatch", "series-cycle", "duplicate-book-number", "canon-name-mismatch", "canon-pronunciation-mismatch", "canon-death-status", "canon-posthumous-appearance", "canon-posthumous-learning", "canon-destroyed-status", "canon-destroyed-artifact-used", "canon-fact-relearned", "prose-filter-words", "prose-adverbs", "prose-bookisms", "prose-avoided-spelling", "prose-uniform-sentences", "prose-similar-names", "pacing-no-hook", "pacing-no-sequel", "pacing-easy-wins", "pacing-resolution-run", "pacing-long-chapter", "pacing-short-chapter", "clue-unplanted", "clue-late-plant", "clue-no-characters", "clue-herring-unresolved", "clue-none-delayed", "voice-avoid", "voice-words-unused", "voice-sound-alike", "name-clash", "name-look-alike", "name-shared-initial", "context-file-skipped", "story-missing-at-ref", "similarity-shared-passage", "similarity-no-reference-text", "derived-ifid", "scene-outside-book", "scene-no-location", "scene-unknown-location", "chapter-no-scenes", "scene-no-setting", "unknown-reference", "adopted-references", "linked-book-id", "choices-dropped", "leftover-references", "stale-exemption", "kept-story-options", "unsplit-chapter-lines", "usage-error", "unusable-project", "write-refused", "command-failed"], "description": "The stable rule code of the finding, as docs/cli-reference.md lists it and story.md severity names it. A command that failed before producing a result uses usage-error, unusable-project, write-refused, or command-failed." },
        "check": { "type": "string", "minLength": 1, "description": "The check that raised the finding: validate, links, continuity, or the command name." },
        "exemption": { "type": "string", "description": "For a dismissed finding, the reason from continuity/exemptions.md, or \"severity <code> is off in story.md\" for a warning a story.md severity entry turned off." },
        "exemptionIndex": { "type": ["integer", "null"], "minimum": 0, "description": "For a dismissed finding, the index in the continuity/exemptions.md exemptions list of the entry that matched it (exemptions[i] in story validate's messages), or null when a story.md severity entry turned it off." }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "check-summary": {
      "type": "object",
      "required": ["ok", "errors", "warnings", "dismissed"],
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "$ref": "#/$defs/count" },
        "warnings": { "$ref": "#/$defs/count" },
        "dismissed": { "$ref": "#/$defs/count" }
      }
    },
    "action": {
      "type": "object",
      "required": ["priority", "title", "detail"],
      "properties": {
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "title": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "word-count": {
      "type": "object",
      "required": ["word", "count"],
      "properties": { "word": { "type": "string" }, "count": { "$ref": "#/$defs/count" } }
    },
    "data-check": {
      "type": "object",
      "required": ["errors", "warnings", "dismissed"],
      "properties": {
        "errors": { "$ref": "#/$defs/count" },
        "warnings": { "$ref": "#/$defs/count" },
        "dismissed": { "$ref": "#/$defs/count" }
      }
    },
    "data-series": {
      "type": "object",
      "required": ["root", "series", "seriesTitle", "books", "ordered", "shared"],
      "properties": {
        "root": { "type": "string" },
        "series": { "type": ["string", "null"] },
        "seriesTitle": { "type": ["string", "null"] },
        "books": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "label", "bookNumber", "status"],
            "properties": {
              "title": { "type": "string" },
              "label": { "type": "string" },
              "bookNumber": { "type": ["number", "null"] },
              "status": { "description": "The book's story.md status as written, or null when unset." }
            }
          }
        },
        "ordered": { "type": "boolean" },
        "shared": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "ids"],
            "properties": { "label": { "type": "string" }, "ids": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    },
    "data-next": {
      "type": "object",
      "required": ["root", "title", "storyId", "actions", "checks"],
      "properties": {
        "root": { "type": "string" },
        "title": { "type": "string" },
        "storyId": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "checks": { "$ref": "#/$defs/checks" }
      }
    },
    "checks": {
      "type": "object",
      "required": ["validate", "links", "continuity"],
      "properties": {
        "validate": { "$ref": "#/$defs/check-summary" },
        "links": { "$ref": "#/$defs/check-summary" },
        "continuity": { "$ref": "#/$defs/check-summary" }
      }
    },
    "data-report": {
      "type": "object",
      "$comment": "series, bookNumber, genre, subGenre, status, pov, tense, and schemaVersion are copied from story.md frontmatter as written, or null when unset.",
      "required": ["root", "title", "storyId", "schemaVersion", "series", "bookNumber", "genre", "subGenre", "form", "status", "pov", "tense", "targetWords", "counts", "chapters", "arcs", "checks", "actions"],
      "properties": {
        "root": { "type": "string" },
        "title": { "type": "string" },
        "storyId": { "type": "string" },
        "form": { "type": "string" },
        "targetWords": { "type": ["integer", "null"] },
        "counts": {
          "type": "object",
          "required": ["characters", "locations", "systems", "factions", "artifacts", "arcs", "chapters", "scenes", "questions", "promises", "clues", "glossaryTerms", "research", "words"],
          "properties": {
            "characters": { "$ref": "#/$defs/count" },
            "locations": { "$ref": "#/$defs/count" },
            "systems": { "$ref": "#/$defs/count" },
            "factions": { "$ref": "#/$defs/count" },
            "artifacts": { "$ref": "#/$defs/count" },
            "arcs": { "$ref": "#/$defs/count" },
            "chapters": { "$ref": "#/$defs/count" },
            "scenes": { "$ref": "#/$defs/count" },
            "questions": { "$ref": "#/$defs/count" },
            "promises": { "$ref": "#/$defs/count" },
            "clues": { "$ref": "#/$defs/count" },
            "glossaryTerms": { "$ref": "#/$defs/count" },
            "research": { "$ref": "#/$defs/count" },
            "words": { "$ref": "#/$defs/count" }
          }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "title", "status", "pov", "wordCount"],
            "properties": { "wordCount": { "$ref": "#/$defs/count" } }
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "status", "characters"],
            "properties": { "characters": { "$ref": "#/$defs/count" } }
          }
        },
        "checks": { "$ref": "#/$defs/checks" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "data-context": {
      "type": "object",
      "required": ["target", "budget", "estimatedTokens", "sections", "omitted", "warnings"],
      "properties": {
        "target": {
          "type": "object",
          "required": ["kind", "id", "chapter", "number", "title"],
          "properties": {
            "kind": { "enum": ["chapter", "scene"] },
            "id": { "type": "string", "minLength": 1 },
            "chapter": { "type": "string", "minLength": 1, "description": "The target's chapter id: the target itself, or the scene's chapter." },
            "number": { "type": "integer", "minimum": 1 },
            "title": { "type": "string" }
          }
        },
        "budget": { "type": "integer", "minimum": 1 },
        "estimatedTokens": { "type": "integer", "minimum": 0, "description": "The estimated tokens of the included items, at ceil(words * 4 / 3) each." },
        "sections": {
          "type": "array",
          "description": "Every section in priority order, each with every candidate item; an item's included says whether it fit the budget.",
          "items": {
            "type": "object",
            "required": ["id", "title", "items"],
            "properties": {
              "id": { "enum": ["target", "essentials", "pov", "characters", "locations", "threads", "scenes"] },
              "title": { "type": "string" },
              "items": { "type": "array", "items": { "$ref": "#/$defs/context-item" } }
            }
          }
        },
        "omitted": {
          "type": "array",
          "description": "The items left out to fit the budget, in priority order.",
          "items": {
            "type": "object",
            "required": ["id", "label", "source", "tokens"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "source": { "type": "string", "description": "The project files the item draws on, comma-separated." },
              "tokens": { "$ref": "#/$defs/count" }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" }, "description": "Project files left out because they failed to parse; also reported as diagnostics." }
      }
    },
    "context-item": {
      "type": "object",
      "required": ["id", "label", "source", "text", "tokens", "included"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "The kind and id, such as character:mara-quill or scene:chapter-02-scene-01." },
        "label": { "type": "string" },
        "source": { "type": "string", "description": "The project files the item draws on, comma-separated." },
        "text": { "type": "string", "description": "The item as markdown." },
        "tokens": { "$ref": "#/$defs/count" },
        "included": { "type": "boolean" }
      }
    },
    "data-knowledge": {
      "type": "object",
      "required": ["character", "at", "entries", "state", "changes"],
      "properties": {
        "character": { "type": "string" },
        "at": { "type": "string" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["knows", "learnedIn"],
            "properties": {
              "knows": { "type": "string" },
              "learnedIn": { "type": "string", "description": "The chapter id it was learned in, or empty for pre-existing knowledge." }
            }
          }
        },
        "state": { "type": "object", "description": "The character's frontmatter with every progression up to and including the chapter applied, and progressions left out." },
        "changes": {
          "type": "array",
          "description": "The progressions applied by the chapter, oldest first.",
          "items": {
            "type": "object",
            "required": ["field", "value", "from"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "value": { "type": ["string", "number", "boolean"] },
              "from": { "type": "string", "minLength": 1, "description": "The chapter the change takes effect from." },
              "previous": { "description": "The value the change replaced; absent when the field was not set before." }
            }
          }
        }
      }
    },
    "data-timeline": {
      "type": "object",
      "required": ["totalChapters", "chronology", "undated", "pov", "presence"],
      "properties": {
        "totalChapters": { "$ref": "#/$defs/count" },
        "chronology": { "type": "array", "items": { "$ref": "#/$defs/timeline-scene" } },
        "undated": { "type": "array", "items": { "$ref": "#/$defs/timeline-scene" } },
        "pov": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["pov", "chapters", "words", "share"],
            "properties": {
              "pov": { "type": "string" },
              "chapters": { "$ref": "#/$defs/count" },
              "words": { "$ref": "#/$defs/count" },
              "share": { "type": "number", "minimum": 0 }
            }
          }
        },
        "presence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "chapters", "first", "last", "longestGap", "gapAfter", "trailing", "died"],
            "properties": {
              "id": { "type": "string" },
              "chapters": { "$ref": "#/$defs/count" },
              "first": { "type": ["integer", "null"] },
              "last": { "type": ["integer", "null"] },
              "longestGap": { "$ref": "#/$defs/count" },
              "gapAfter": { "type": ["integer", "null"] },
              "trailing": { "$ref": "#/$defs/count" },
              "died": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },
    "timeline-scene": {
      "type": "object",
      "required": ["id", "file", "title", "chapterNumber", "pov", "location", "date", "time", "reading"],
      "properties": {
        "id": { "type": "string" },
        "file": { "type": "string" },
        "title": { "type": "string" },
        "pov": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "reading": { "$ref": "#/$defs/count" }
      }
    },
    "data-similarity": {
      "type": "object",
      "required": ["label", "minWords", "reference", "words", "sharedWords", "chapters", "passages"],
      "properties": {
        "label": { "type": "string", "description": "The --against text as given, or \"git ref <ref>\"." },
        "minWords": { "type": "integer", "minimum": 5, "description": "The shortest shared run reported, after --min-words and story.md cli-defaults." },
        "reference": {
          "type": "object",
          "required": ["files", "words"],
          "properties": { "files": { "$ref": "#/$defs/count" }, "words": { "$ref": "#/$defs/count" } }
        },
        "words": { "$ref": "#/$defs/count" },
        "sharedWords": { "$ref": "#/$defs/count" },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "title", "words", "sharedWords", "passages"],
            "properties": {
              "file": { "type": "string" },
              "title": { "type": "string" },
              "words": { "$ref": "#/$defs/count" },
              "sharedWords": { "$ref": "#/$defs/count" },
              "passages": { "$ref": "#/$defs/count" }
            }
          }
        },
        "passages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "from", "to", "words", "text", "reference"],
            "properties": {
              "file": { "type": "string" },
              "from": { "type": "string", "description": "Paragraph label of the passage's first word, as the review copy labels it (ch03-p12)." },
              "to": { "type": "string" },
              "words": { "type": "integer", "minimum": 5 },
              "text": { "type": "string", "description": "The shared words as written in the chapter; paragraphs are joined with \" / \"." },
              "reference": {
                "type": "object",
                "required": ["file", "from", "to", "text"],
                "properties": {
                  "file": { "type": "string", "description": "Path from the working directory, or <ref>:<path> for a git ref." },
                  "from": { "type": "string", "description": "A chapter label (ch07-p4) for a story project, or p4 for a plain file." },
                  "to": { "type": "string" },
                  "text": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "data-prose": {
      "type": "object",
      "required": ["styleSheet", "words", "chapters", "phrases", "similarNames", "thresholds"],
      "properties": {
        "styleSheet": { "type": "boolean" },
        "thresholds": {
          "type": "object",
          "description": "The warning limits the run used, after --max-filter-words, --max-adverbs, --max-bookisms, and story.md cli-defaults.",
          "required": ["maxFilterWords", "maxAdverbs", "maxBookisms"],
          "properties": {
            "maxFilterWords": { "type": "number", "minimum": 0 },
            "maxAdverbs": { "type": "number", "minimum": 0 },
            "maxBookisms": { "$ref": "#/$defs/count" }
          }
        },
        "words": { "$ref": "#/$defs/count" },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "title", "analysis"],
            "properties": {
              "file": { "type": "string" },
              "title": { "type": "string" },
              "analysis": {
                "type": "object",
                "required": ["words", "narrationWords", "sentences", "filterWords", "adverbs", "plainTags", "bookisms", "echoes", "watch", "variants"],
                "properties": {
                  "words": { "$ref": "#/$defs/count" },
                  "narrationWords": { "$ref": "#/$defs/count" },
                  "sentences": {
                    "type": "object",
                    "required": ["count", "mean", "longest", "spread"],
                    "properties": {
                      "count": { "$ref": "#/$defs/count" },
                      "mean": { "type": "number" },
                      "longest": { "$ref": "#/$defs/count" },
                      "spread": { "type": "number" }
                    }
                  },
                  "filterWords": { "type": "array", "items": { "$ref": "#/$defs/word-count" } },
                  "adverbs": { "type": "array", "items": { "$ref": "#/$defs/word-count" } },
                  "plainTags": { "type": "array", "items": { "$ref": "#/$defs/word-count" } },
                  "bookisms": { "type": "array", "items": { "$ref": "#/$defs/word-count" } },
                  "echoes": { "type": "array", "items": { "$ref": "#/$defs/word-count" } },
                  "watch": { "type": "array", "items": { "$ref": "#/$defs/word-count" } },
                  "variants": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["use", "avoid", "source", "count"],
                      "properties": { "use": { "type": "string" }, "avoid": { "type": "string" }, "source": { "type": "string" }, "count": { "$ref": "#/$defs/count" } }
                    }
                  }
                }
              }
            }
          }
        },
        "phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phrase", "count"],
            "properties": { "phrase": { "type": "string" }, "count": { "$ref": "#/$defs/count" } }
          }
        },
        "similarNames": {
          "type": "array",
          "description": "Pairs of characters whose first names a reader could confuse.",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "first"],
              "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "first": { "type": "string" } }
            }
          }
        }
      }
    },
    "data-voices": {
      "type": "object",
      "required": ["profiles", "unattributed"],
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "lines", "words", "sentenceLength", "contractions", "questions", "exclamations", "signature"],
            "properties": {
              "id": { "type": "string" },
              "lines": { "$ref": "#/$defs/count" },
              "words": { "$ref": "#/$defs/count" },
              "sentenceLength": { "type": "number" },
              "contractions": { "type": "number" },
              "questions": { "type": "number" },
              "exclamations": { "type": "number" },
              "signature": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "unattributed": { "$ref": "#/$defs/count" }
      }
    },
    "data-pacing": {
      "type": "object",
      "required": ["rows", "medianWords", "totals"],
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "number", "words", "scenes", "sequels", "outcomes", "hook", "status"],
            "properties": {
              "id": { "type": "string" },
              "words": { "$ref": "#/$defs/count" },
              "scenes": { "$ref": "#/$defs/count" },
              "sequels": { "$ref": "#/$defs/count" },
              "outcomes": {
                "type": "object",
                "required": ["yes", "no", "yes-but", "no-and"],
                "properties": {
                  "yes": { "$ref": "#/$defs/count" },
                  "no": { "$ref": "#/$defs/count" },
                  "yes-but": { "$ref": "#/$defs/count" },
                  "no-and": { "$ref": "#/$defs/count" }
                }
              },
              "hook": { "type": "string" }
            }
          }
        },
        "medianWords": { "type": "number", "minimum": 0 },
        "totals": {
          "type": "object",
          "required": ["scenes", "sequels", "outcomesRecorded", "setbacks", "hooks"],
          "properties": {
            "scenes": { "$ref": "#/$defs/count" },
            "sequels": { "$ref": "#/$defs/count" },
            "outcomesRecorded": { "$ref": "#/$defs/count" },
            "setbacks": { "$ref": "#/$defs/count" },
            "hooks": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "data-clues": {
      "type": "object",
      "required": ["chapters", "rows", "totals"],
      "properties": {
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "number"],
            "properties": { "id": { "type": "string" } }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "redHerring", "significanceDelayed", "cells"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "redHerring": { "type": "boolean" },
              "significanceDelayed": { "type": "boolean" },
              "cells": { "type": "array", "items": { "type": "string" }, "description": "One cell per entry in chapters, in the same order." }
            }
          }
        },
        "totals": {
          "type": "object",
          "required": ["clues", "redHerrings", "planted", "revealed"],
          "properties": {
            "clues": { "$ref": "#/$defs/count" },
            "redHerrings": { "$ref": "#/$defs/count" },
            "planted": { "$ref": "#/$defs/count" },
            "revealed": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "data-progress": {
      "type": "object",
      "required": ["logged", "words", "target", "percent", "remaining", "deadline", "chapters", "sessions", "lastSession", "pace", "projected"],
      "properties": {
        "logged": {
          "type": ["object", "null"],
          "required": ["file", "date", "words"],
          "properties": { "file": { "type": "string" }, "date": { "type": "string" }, "words": { "$ref": "#/$defs/count" } }
        },
        "words": { "$ref": "#/$defs/count" },
        "target": { "type": ["integer", "null"] },
        "percent": { "type": ["number", "null"] },
        "remaining": { "type": ["integer", "null"] },
        "deadline": {
          "type": ["object", "null"],
          "required": ["date", "daysLeft", "perDay"],
          "properties": { "date": { "type": "string" }, "daysLeft": { "type": "integer" }, "perDay": { "type": ["integer", "null"] } }
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "words", "target", "percent"],
            "properties": { "id": { "type": "string" }, "words": { "$ref": "#/$defs/count" }, "target": { "type": "integer" }, "percent": { "type": "number" } }
          }
        },
        "sessions": { "$ref": "#/$defs/count" },
        "lastSession": {
          "type": ["object", "null"],
          "required": ["date", "words", "since"],
          "properties": { "date": { "type": "string" }, "words": { "$ref": "#/$defs/count" }, "since": { "type": "integer" } }
        },
        "pace": { "type": ["number", "null"] },
        "projected": { "type": ["string", "null"] }
      }
    }
  }
}
